{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ECTOS_PACKAGE_DEPENDENCY_GRAPH_V01",
  "title": "ECTOS Package Dependency Graph V01",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "package", "nodes", "edges", "closure", "change_impact"],
  "properties": {
    "schema_id": {"const": "ECTOS_PACKAGE_DEPENDENCY_GRAPH_V01"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_name", "version", "package_sha256", "environment", "producer"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "package_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "package_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "environment": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "source_repository": {"type": ["string", "null"]},
        "source_commit": {"type": ["string", "null"]}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dependency_id", "type", "name", "currentness", "physical_evidence", "test_coverage", "fail_closed_behavior", "impact_if_changed"],
        "properties": {
          "dependency_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["PACKAGE", "ENGINE", "SOURCE_FILE", "MODULE", "CALL_IMPORT", "WORKFLOW", "TEST", "FIXTURE", "CONFIGURATION", "ENVIRONMENT", "OS_RUNTIME", "PROCESS", "STATE", "REGISTRY", "AUTHORITY", "UAC", "HANDOFF", "OUTPUT_ARTIFACT", "EXTERNAL_SERVICE", "REPOSITORY", "OTHER"]},
          "name": {"type": "string", "minLength": 1},
          "locator": {"type": ["string", "null"]},
          "currentness": {"enum": ["CURRENT", "HISTORICAL", "SUPERSEDED", "NOT_PROVEN"]},
          "physical_evidence": {"type": "string", "minLength": 1},
          "test_coverage": {"type": "string", "minLength": 1},
          "fail_closed_behavior": {"type": "string", "minLength": 1},
          "impact_if_changed": {"type": "string", "minLength": 1},
          "external_ref": {"type": ["string", "null"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "from", "to", "type", "direct_or_transitive", "required_by", "contract", "currentness", "physical_evidence", "test_coverage", "fail_closed_behavior", "status"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "type": {"enum": ["DEPENDS_ON", "CALLS", "IMPORTS", "LOADS", "REQUIRES", "GENERATES", "VALIDATES", "ROUTES_TO", "CONSUMES", "PRODUCES", "BINDS", "EXECUTES_ON", "READS_STATE", "WRITES_STATE", "GUARDED_BY", "QUALIFIED_BY", "HANDS_OFF_TO", "AGGREGATES", "OTHER"]},
          "direct_or_transitive": {"enum": ["DIRECT", "TRANSITIVE"]},
          "required_by": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "currentness": {"enum": ["CURRENT", "HISTORICAL", "SUPERSEDED", "NOT_PROVEN"]},
          "physical_evidence": {"type": "string", "minLength": 1},
          "test_coverage": {"type": "string", "minLength": 1},
          "fail_closed_behavior": {"type": "string", "minLength": 1},
          "status": {"enum": ["RESOLVED", "UNRESOLVED", "NOT_PROVEN"]}
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_closure", "undeclared_dependency_count", "unresolved_transitive_dependency_count", "untested_dependency_count", "implicit_environment_assumption_count", "unknown_blast_radius_edge_count"],
      "properties": {
        "dependency_closure": {"enum": ["PASS", "FAIL", "NOT_PROVEN"]},
        "undeclared_dependency_count": {"type": "integer", "minimum": 0},
        "unresolved_transitive_dependency_count": {"type": "integer", "minimum": 0},
        "untested_dependency_count": {"type": "integer", "minimum": 0},
        "implicit_environment_assumption_count": {"type": "integer", "minimum": 0},
        "unknown_blast_radius_edge_count": {"type": "integer", "minimum": 0}
      }
    },
    "change_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_package_sha256", "changed_dependency_ids", "impacted_dependency_ids", "analysis_status"],
      "properties": {
        "predecessor_package_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "changed_dependency_ids": {"type": "array", "items": {"type": "string"}},
        "impacted_dependency_ids": {"type": "array", "items": {"type": "string"}},
        "analysis_status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_PROVEN"]}
      }
    }
  }
}
