      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "route_register_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "execution_return_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "evidence_bundle_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "defect_register_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "not_proven_register_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "qualifier_id": {
      "type": "string",
      "minLength": 1
    },
    "qualifier_version": {
      "type": "string",
