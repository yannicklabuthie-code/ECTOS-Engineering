  "required": [
    "source_repository",
    "remote_commit",
    "local_head",
    "worktree_path",
    "host_identity",
    "runtime_identity",
    "member_selection_model_identity",
    "gitattributes_identity",
    "git_config_origin_evidence",
    "git_ls_files_eol",
    "workspace_raw_object_sha",
    "committed_blob_sha",
    "workspace_sha256",
    "blob_sha256",
    "worktree_clean",
    "index_clean",
    "untracked_objects",
    "ignored_execution_relevant_objects",
    "workspace_evidence_source",
    "raw_byte_identity_result",
