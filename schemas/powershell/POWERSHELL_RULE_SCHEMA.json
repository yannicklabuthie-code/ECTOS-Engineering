{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ECTOS_POWERSHELL_RULE_SCHEMA_V01",
  "type": "object",
  "required": [
    "rule_id",
    "rule_version",
    "language",
    "target_runtime",
    "defect_family_id",
    "title",
    "description",
    "bad_pattern",
    "approved_pattern",
    "detection_method",
    "severity",
    "build_blocking",
    "positive_fixture",
    "negative_fixture",
    "static_detector",
    "native_runtime_check",
    "regression_required",
    "historical_source",
    "currentness",
    "status"
  ],
  "properties": {
    "rule_id": {"type":"string","pattern":"^PS51-R[0-9]{3}$"},
    "rule_version": {"type":"string","pattern":"^V[0-9]{2}$"},
    "language": {"const":"POWERSHELL"},
    "target_runtime": {"const":"WINDOWS_POWERSHELL_DESKTOP_5_1"},
    "defect_family_id": {"type":"string","minLength":3},
    "title": {"type":"string","minLength":3},
    "description": {"type":"string","minLength":3},
    "bad_pattern": {},
    "approved_pattern": {},
    "detection_method": {"type":"object"},
    "severity": {"enum":["BLOCKER","HIGH","MEDIUM","LOW"]},
    "build_blocking": {"type":"boolean"},
    "positive_fixture": {"type":"string"},
    "negative_fixture": {"type":"string"},
    "static_detector": {"type":"string"},
    "native_runtime_check": {"type":["string","null"]},
    "regression_required": {"type":"boolean"},
    "historical_source": {"type":"object","required":["source","evidence_id"]},
    "currentness": {"enum":["CURRENT","HISTORICAL","SUPERSEDED","PARTIAL","NOT_PROVEN"]},
    "status": {"enum":["ACTIVE","SUPERSEDED","DRAFT"]}
  },
  "additionalProperties": false
}
