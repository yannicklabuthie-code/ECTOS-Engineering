{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ECTOS_QC_ENVELOPE_V01",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","message_id","mission_id","source_component_id","target_component_id","source_run_id","source_authority_id","target_package_id","target_package_sha256","payload_type","payload_sha256","currentness_state","trust_state","created_at","issuer_id","mutation_allowed","mutation_scope","status","evidence_references","errors","not_proven_items","blockers"],
  "properties": {
    "schema_id": {"const": "ECTOS_QC_ENVELOPE_V01"},
    "schema_version": {"const": "V01"},
    "message_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "source_component_id": {"type": "string", "minLength": 1},
    "target_component_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_authority_id": {"type": "string", "minLength": 1},
    "target_package_id": {"type": "string", "minLength": 1},
    "target_package_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "predecessor_message_id": {"type": ["string","null"]},
    "predecessor_message_sha256": {"type": ["string","null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "payload_type": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "currentness_state": {"enum": ["CURRENT","HISTORICAL","SUPERSEDED","PARTIAL","NOT_PROVEN"]},
    "trust_state": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "issuer_id": {"type": "string", "minLength": 1},
    "mutation_allowed": {"type": "boolean"},
    "mutation_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["PASS","FAIL","BLOCKED","NOT_PROVEN","NOT_EXECUTED","NOT_APPLICABLE"]},
    "evidence_references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "errors": {"type": "array", "items": {"type": "string"}},
    "not_proven_items": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
