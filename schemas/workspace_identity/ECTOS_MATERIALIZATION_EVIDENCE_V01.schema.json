    "workspace_raw_object_sha": {
      "type": "object"
    },
    "workspace_sha256": {
      "type": "object"
    },
    "worktree_clean": {
      "const": true
    },
    "worktree_path": {
      "minLength": 1,
      "type": "string"
    }
