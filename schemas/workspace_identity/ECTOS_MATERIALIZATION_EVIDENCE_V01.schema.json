{
  "$id": "ECTOS_MATERIALIZATION_EVIDENCE_V01_SCHEMA",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blob_sha256": {
      "type": "object"
    },
    "committed_blob_sha": {
      "type": "object"
    },
    "git_config_origin_evidence": {
      "type": "object"
    },
    "git_ls_files_eol": {
      "type": "object"
    },
    "gitattributes_identity": {
      "type": "object"
    },
    "host_identity": {
      "minLength": 1,
      "type": "string"
    },
    "ignored_execution_relevant_objects": {
      "maxItems": 0,
      "type": "array"
    },
    "index_clean": {
      "const": true
    },
    "local_head": {
      "pattern": "^[A-Fa-f0-9]{40}$",
      "type": "string"
    },
    "materialization_evidence_current": {
      "const": true
    },
    "member_selection_model_identity": {
      "type": "object"
    },
    "raw_byte_identity_result": {
      "const": "PASS"
    },
    "remote_commit": {
      "pattern": "^[A-Fa-f0-9]{40}$",
      "type": "string"
    },
    "runtime_identity": {
      "minLength": 1,
      "type": "string"
    },
    "source_repository": {
      "minLength": 1,
      "type": "string"
    },
    "untracked_objects": {
      "maxItems": 0,
      "type": "array"
    },
    "workspace_evidence_source": {
      "const": "RAW_WORKSPACE_BYTES"
