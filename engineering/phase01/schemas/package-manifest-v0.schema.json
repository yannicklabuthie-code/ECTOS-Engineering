{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ECTOS_COMMON_PACKAGE_MANIFEST_V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "package_type",
    "package_id",
    "version",
    "source_commit",
    "build_id",
    "target_runtime",
    "supported_os",
    "entrypoint",
    "expected_output_contract",
    "side_effect_contract",
    "mutation_policy",
    "test_profile",
    "qualification_profile",
    "install_profile",
    "rollback_profile",
    "evidence_profile"
  ],
  "properties": {
    "schema_id": {
      "const": "ECTOS_COMMON_PACKAGE_MANIFEST_V0"
    },
    "package_type": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "package_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "target_runtime": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supported_os": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supported_powershell_version": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "expected_output_contract": {
      "type": "string",
      "minLength": 1
    },
    "side_effect_contract": {
      "type": "string",
      "minLength": 1
    },
    "mutation_policy": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_profile": {
      "type": "string",
      "minLength": 1
    },
    "qualification_profile": {
      "type": "string",
      "minLength": 1
    },
    "install_profile": {
      "type": "string",
      "minLength": 1
    },
    "rollback_profile": {
      "type": "string",
      "minLength": 1
    },
    "evidence_profile": {
      "type": "string",
      "minLength": 1
    }
  }
}
