  "schema_path": "schemas/workspace_identity/ECTOS_GENERIC_WORKSPACE_IDENTITY_CONTRACT_V02.schema.json",
  "scope": "CROSS_PLATFORM_GOVERNED_WORKSPACE_BYTE_IDENTITY",
  "status": "CURRENT_CANDIDATE",
  "supported_os": [
    "WINDOWS",
    "LINUX",
    "MACOS"
  ],
  "supported_runtime_classes": [
    "PYTHON",
    "JSON_DATA",
    "MARKDOWN_GOVERNANCE",
    "YAML_WORKFLOW",
    "TEXT_IDENTITY_INPUT"
  ],
  "version": "V02",
  "worktree_byte_identity_rule": {
    "clean_git_status_is_sufficient": false,
    "committed_object_command": "git rev-parse HEAD:<repository-relative-path>",
    "eol_command": "git ls-files --eol <repository-relative-path>",
    "required_comparison": "EQUAL",
    "selected_text_required_workspace_eol": "w/lf",
    "workspace_object_command": "git hash-object --no-filters <workspace-file>"
  }
