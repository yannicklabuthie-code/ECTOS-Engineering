{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ECTOS_QC_EXECUTION_RESULT_V01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "run_id",
    "start_time",
    "end_time",
    "process_id",
    "exit_code",
    "timeout_state",
    "termination_state",
    "stdout_sha256",
    "stderr_sha256",
    "raw_stdout_ref",
    "raw_stderr_ref",
    "created_outputs",
    "observed_property",
    "preliminary_result",
    "route_id",
    "property_id",
    "control_id",
    "tool_id",
    "tool_sha256",
    "command_path",
    "working_directory",
    "arguments",
    "script_path",
    "script_sha256",
    "script_unchanged"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "process_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout_state": {
      "enum": [
        "NOT_TIMED_OUT",
        "TIMED_OUT",
        "NOT_PROVEN"
      ]
    },
    "termination_state": {
      "type": "string",
      "minLength": 1
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "raw_stdout_ref": {
      "type": "string",
      "minLength": 1
    },
    "raw_stderr_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "observed_property": {
      "type": "string"
    },
    "preliminary_result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_PROVEN",
        "NOT_EXECUTED",
        "NOT_APPLICABLE"
      ]
    },
    "route_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "command_path": {
      "type": "string"
    },
    "working_directory": {
      "type": "string"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "script_path": {
      "type": "string",
      "minLength": 1
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "script_unchanged": {
      "type": "boolean"
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_profile",
        "runtime_profile"
      ],
      "properties": {
        "platform_profile": {
          "const": "WINDOWS"
        },
        "runtime_profile": {
          "const": "WINDOWS_POWERSHELL_DESKTOP_5_1"
        }
      }
    }
  }
}
